--- !u!114 &877929273
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 877929272}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f53126adb36696448eea7470471cb5b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  day1Manager: {fileID: 34712346}
  tutorialOverlay: {fileID: 1991955089}
  clickBlocker: {fileID: 676241390}
  box: {fileID: 531530005}
  tutorialText: {fileID: 663860498}
  stepCounterText: {fileID: 682370816}
  nextButton: {fileID: 2001982929}
  nextButtonLabel: {fileID: 1966712785}
  skipButton: {fileID: 1007449478}
  arrow: {fileID: 1229550655}
  arrowGap: 10
  bobAmount: 20
  bobSpeed: 6
  restartGameAfterTutorial: 1
  fadeGroup: {fileID: 352295847}
  fadeOutTime: 1
  fadeInTime: 1
  alwaysShowTutorial: 1
  steps:
  - text: Welcome to Medisina, Doctor! I'll guide you through your first patient.
      You can SKIP anytime.
    targetButton: {fileID: 0}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 1
    allowAnyClick: 0
  - text: Click the PATIENT FILE to read the patient's information.
    targetButton: {fileID: 591893638}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: Read the file and compare it with how the patient looks. Press NEXT when
      you're done.
    targetButton: {fileID: 0}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: This patient looks legitimate. Click ACCEPT.
    targetButton: {fileID: 969686776}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: Now open the MEDICINE BOOK to find out the patient's illness.
    targetButton: {fileID: 2005065860}
    pointAt: {fileID: 0}
    arrowPoints: 2
    boxPosition: 0
    allowAnyClick: 0
  - text: Turn the pages to the SYMPTOMS page and tap the symptoms the patient has.
      The book highlights the possible illness. Press NEXT when done.
    targetButton: {fileID: 0}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 2
    allowAnyClick: 1
  - text: Check the COMPOUNDS and MEDICINES pages. Paracetamol is made by mixing
      p-Aminophenol (dish) and Acetic Anhydride (flask). Press NEXT.
    targetButton: {fileID: 0}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 2
    allowAnyClick: 1
  - text: Close the book.
    targetButton: {fileID: 205991360}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: Go to the MIXING AREA.
    targetButton: {fileID: 246580345}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: Click the DISH to put it on your table.
    targetButton: {fileID: 138753753}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: Pick up p-AMINOPHENOL from the cabinet.
    targetButton: {fileID: 478134564}
    pointAt: {fileID: 0}
    arrowPoints: 2
    boxPosition: 0
    allowAnyClick: 0
  - text: Click the dish to put the p-Aminophenol in it.
    targetButton: {fileID: 1832819007}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: Now click the FLASK.
    targetButton: {fileID: 1560000241}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: Pick up ACETIC ANHYDRIDE from the cabinet.
    targetButton: {fileID: 2059630404}
    pointAt: {fileID: 0}
    arrowPoints: 2
    boxPosition: 0
    allowAnyClick: 0
  - text: Click the flask to pour it in.
    targetButton: {fileID: 263119829}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: Click MIX!
    targetButton: {fileID: 870950236}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: Pick up the mixed medicine.
    targetButton: {fileID: 1169955436}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: Made a mistake? Pick up a compound and click the TRASH CAN to throw it
      away. But it costs the patient's time! Press NEXT.
    targetButton: {fileID: 0}
    pointAt: {fileID: 1444568939}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: Go back to the patient.
    targetButton: {fileID: 0}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: Give the medicine to the patient.
    targetButton: {fileID: 0}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 0
    allowAnyClick: 0
  - text: Great job, Doctor! Now let's begin your real shift. Good luck!
    targetButton: {fileID: 0}
    pointAt: {fileID: 0}
    arrowPoints: 0
    boxPosition: 1
    allowAnyClick: 0
